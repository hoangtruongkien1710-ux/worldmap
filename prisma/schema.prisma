// WorldMap – quản lý lớp học + kế toán (dùng chung một database)
// Quy ước: tiền lưu số nguyên VND; ngày học lưu kiểu DATE; giờ lưu chuỗi "HH:mm".

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Danh mục chung ----------

model Branch {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  address   String?
  phone     String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  users     User[]
  classes   Class[]
  students  Student[]
  rooms     Room[]
}

enum Role {
  ADMIN
  MANAGER
  ACCOUNTANT
  TEACHER
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  fullName     String
  role         Role
  phone        String?
  active       Boolean  @default(true)
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])
  classes      Class[]  @relation("ClassTeacher")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Subject {
  id      Int     @id @default(autoincrement())
  name    String  @unique
  classes Class[]
}

// Đối tượng / trình độ học viên (VD: THCS–THPT, Sinh viên – Người đi làm)
model Grade {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  order    Int       @default(0)
  classes  Class[]
  students Student[]
}

model Room {
  id       Int     @id @default(autoincrement())
  name     String
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])
  classes  Class[]

  @@unique([branchId, name])
}

// ---------- Chương trình & khóa học (bảng giá niêm yết) ----------

model Program {
  id      String   @id @default(cuid())
  code    String   @unique // HSK, IELTS, TOEIC
  name    String
  color   String   @default("#2463eb")
  order   Int      @default(0)
  courses Course[]
}

enum PriceUnit {
  COURSE // giá trọn khóa
  SESSION // giá theo buổi (lớp 1-1)
}

model Course {
  id              String    @id @default(cuid())
  programId       String
  program         Program   @relation(fields: [programId], references: [id])
  code            String    @unique // "HSK 1", "IELTS FDN", "TOEIC A"
  name            String // "HSK 1", "IELTS Mindset 1"
  level           String? // "HSK 1", "THCS–THPT", "BASIC"
  description     String? // "Nhập môn tiếng Trung", "Mục tiêu 0–350 điểm"
  target          String? // "Band 3.5–4.5"
  sessionsMin     Int?
  sessionsMax     Int?
  sessionsPerWeek String? // "2", "2–3"
  durationText    String? // "~3 tháng"
  sessionHours    Decimal?  @db.Decimal(3, 1)
  listedPrice     Int
  priceUnit       PriceUnit @default(COURSE)
  classSizeMin    Int?
  classSizeMax    Int?
  coursebook      String?
  order           Int       @default(0)
  active          Boolean   @default(true)
  classes         Class[]
  materials       CourseMaterial[]
}

/// Tài liệu / giáo trình của khóa: file tải lên (PDF, Word…) hoặc đường link.
model CourseMaterial {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  url       String? // gắn link (Google Drive, website…)
  fileName  String? // tên file gốc khi tải lên
  filePath  String? // đường dẫn tương đối trong thư mục uploads
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())

  @@index([courseId])
}

// ---------- Lớp học & lịch ----------

enum FeeMode {
  COURSE // Trọn khóa: học phí niêm yết của khóa (có thể chia đợt)
  PER_SESSION // Theo buổi (VD: IELTS 1-1)
  MONTHLY_FIXED // Thu theo tháng
  PER_SCHEDULED // Theo số buổi học trong tháng
  PACKAGE // Theo gói buổi
  PER_ATTENDED // Theo buổi đã học (có mặt)
}

enum ExcusedPolicy {
  NONE // Không miễn giảm vắng phép
  DEDUCT // Trừ tiền buổi vắng phép
  CARRY_OVER // Bù sang tháng sau
}

enum ClassStatus {
  OPEN
  ENDED
}

model Class {
  id            String          @id @default(cuid())
  code          String          @unique
  name          String
  branchId      String
  branch        Branch          @relation(fields: [branchId], references: [id])
  courseId      String?
  course        Course?         @relation(fields: [courseId], references: [id])
  totalSessions Int? // số buổi của khóa (lớp theo khóa)
  maxStudents   Int?
  subjectId     Int?
  subject       Subject?        @relation(fields: [subjectId], references: [id])
  gradeId       Int?
  grade         Grade?          @relation(fields: [gradeId], references: [id])
  roomId        Int?
  room          Room?           @relation(fields: [roomId], references: [id])
  teacherId     String?
  teacher       User?           @relation("ClassTeacher", fields: [teacherId], references: [id])
  color         String          @default("#2463eb")
  startDate     DateTime        @db.Date
  endDate       DateTime?       @db.Date
  feeMode       FeeMode
  unitPrice     Int // đ/tháng, đ/buổi hoặc đ/gói tùy feeMode
  packageSize   Int? // số buổi trong gói (PACKAGE)
  excusedPolicy ExcusedPolicy   @default(NONE)
  status        ClassStatus     @default(OPEN)
  schedules     ClassSchedule[]
  sessions      Session[]
  enrollments   Enrollment[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([branchId, status])
  @@index([teacherId])
}

model ClassSchedule {
  id        String    @id @default(cuid())
  classId   String
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  weekday   Int // 0 = Chủ nhật … 6 = Thứ Bảy
  startTime String // "18:00"
  endTime   String
  validFrom DateTime  @db.Date
  validTo   DateTime? @db.Date

  @@index([classId])
}

enum SessionStatus {
  SCHEDULED
  CANCELLED
}

enum SessionSource {
  SCHEDULE
  MAKEUP
  MANUAL
}

model Session {
  id            String        @id @default(cuid())
  classId       String
  class         Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  date          DateTime      @db.Date
  startTime     String
  endTime       String
  status        SessionStatus @default(SCHEDULED)
  source        SessionSource @default(SCHEDULE)
  cancelReason  String?
  taughtContent String?
  homework      String?
  attendance    Attendance[]
  createdAt     DateTime      @default(now())

  @@unique([classId, date, startTime])
  @@index([date])
}

// ---------- Học sinh, ghi danh, điểm danh ----------

enum StudentStatus {
  ACTIVE
  INACTIVE
}

model Student {
  id             String        @id @default(cuid())
  code           String        @unique
  fullName       String
  branchId       String
  branch         Branch        @relation(fields: [branchId], references: [id])
  gradeId        Int?
  grade          Grade?        @relation(fields: [gradeId], references: [id])
  school         String?
  phone          String? // số điện thoại của chính học viên
  parentName     String?
  parentRelation String?
  parentPhone    String?
  status         StudentStatus @default(ACTIVE)
  note           String?
  enrollments    Enrollment[]
  attendance     Attendance[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  invoices       Invoice[]

  @@index([parentPhone])
  @@index([branchId, status])
}

enum EnrollmentStatus {
  ACTIVE
  LEFT
}

model Enrollment {
  id              String           @id @default(cuid())
  studentId       String
  student         Student          @relation(fields: [studentId], references: [id])
  classId         String
  class           Class            @relation(fields: [classId], references: [id])
  joinDate        DateTime         @db.Date
  leaveDate       DateTime?        @db.Date
  monthlyDiscount Int              @default(0)
  percentDiscount Int              @default(0)
  status          EnrollmentStatus @default(ACTIVE)
  createdAt       DateTime         @default(now())

  @@index([classId])
  @@index([studentId])
}

enum AttendanceStatus {
  PRESENT
  EXCUSED
  ABSENT
}

model Attendance {
  id          String           @id @default(cuid())
  sessionId   String
  session     Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student          @relation(fields: [studentId], references: [id])
  status      AttendanceStatus
  note        String?
  updatedById String?
  updatedAt   DateTime         @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId])
}

// ---------- Học phí (dùng ở giai đoạn 4) ----------

enum InvoiceStatus {
  OPEN
  LOCKED
}

enum PaymentMethod {
  CASH
  TRANSFER
}

model Invoice {
  id           String        @id @default(cuid())
  studentId    String
  student      Student       @relation(fields: [studentId], references: [id])
  month        String // "2026-11"
  status       InvoiceStatus @default(OPEN)
  lockedAmount Int?
  lockedDetail Json?
  lockedAt     DateTime?
  lockedById   String?
  shareToken   String        @unique @default(cuid())
  payments     Payment[]
  createdAt    DateTime      @default(now())

  @@unique([studentId, month])
}

model Payment {
  id             String        @id @default(cuid())
  invoiceId      String
  invoice        Invoice       @relation(fields: [invoiceId], references: [id])
  classId        String? // lớp được thu (một phiếu có thể gộp nhiều lớp)
  amount         Int
  method         PaymentMethod
  txnRef         String?
  note           String?
  paidAt         DateTime
  collectedById  String
  idempotencyKey String        @unique
  voidedAt       DateTime?
  createdAt      DateTime      @default(now())

  @@index([paidAt])
  @@index([classId])
}

model Adjustment {
  id          String   @id @default(cuid())
  studentId   String
  classId     String?
  month       String
  amount      Int // âm = giảm, dương = thu thêm
  reason      String
  createdById String
  createdAt   DateTime @default(now())

  @@index([studentId, month])
}

// ---------- Nhật ký ----------

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// =====================================================================
// KẾ TOÁN (giao diện /ke-toan) – kiểu MISA rút gọn, bút toán kép
// =====================================================================

enum LedgerType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model LedgerAccount {
  code       String     @id // "111", "1111", "131", "5113", "642"…
  name       String
  parentCode String?
  type       LedgerType
  active     Boolean    @default(true)
}

enum CashKind {
  CASH
  BANK
}

model CashAccount {
  id             String    @id @default(cuid())
  code           String    @unique // "TM", "VCB", "TCB"
  name           String
  kind           CashKind
  bankName       String?
  accountNo      String?
  ledgerCode     String // "1111" tiền mặt, "1121" tiền gửi ngân hàng
  openingBalance Int       @default(0)
  openingDate    DateTime  @db.Date
  active         Boolean   @default(true)
  txns           CashTxn[] @relation("TxnAccount")
  counts         CashCount[]
}

// Kiểm quỹ cuối ngày: số tiền đếm thực tế để so với sổ.
model CashCount {
  id        String      @id @default(cuid())
  accountId String
  account   CashAccount @relation(fields: [accountId], references: [id])
  date      DateTime    @db.Date
  counted   Int
  note      String?
  createdAt DateTime    @default(now())

  @@unique([accountId, date])
}

enum Direction {
  IN
  OUT
}

model TxnCategory {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  name          String
  direction     Direction
  debitAccount  String? // TK Nợ mặc định (chi)
  creditAccount String? // TK Có mặc định (thu)
  order         Int       @default(0)
  txns          CashTxn[]
  payables      Payable[]
}

model Supplier {
  id       String    @id @default(cuid())
  code     String    @unique
  name     String
  phone    String?
  taxCode  String?
  note     String?
  txns     CashTxn[]
  payables Payable[]
}

model Employee {
  id           String        @id @default(cuid())
  code         String        @unique // trùng mã trên máy chấm công / bảng lương
  fullName     String
  department   String // GIAO_VIEN | VAN_PHONG
  position     String?
  userId       String?       @unique
  active       Boolean       @default(true)
  payrollLines PayrollLine[]
}

enum CashTxnType {
  IN // phiếu thu / giấy báo có
  OUT // phiếu chi / giấy báo nợ
  TRANSFER // chuyển tiền nội bộ
}

model CashTxn {
  id              String       @id @default(cuid())
  code            String       @unique // PT2611-0001, PC2611-0001, BC…, BN…, CT…
  type            CashTxnType
  date            DateTime     @db.Date
  accountId       String
  account         CashAccount  @relation("TxnAccount", fields: [accountId], references: [id])
  toAccountId     String?
  categoryId      Int?
  category        TxnCategory? @relation(fields: [categoryId], references: [id])
  amount          Int
  description     String
  counterparty    String?
  supplierId      String?
  supplier        Supplier?    @relation(fields: [supplierId], references: [id])
  studentId       String?
  paymentId       String?      @unique // sinh tự động từ thu học phí
  payableId       String?
  payrollPeriodId String?
  createdAt       DateTime     @default(now())
  voidedAt        DateTime?

  @@index([date])
  @@index([accountId, date])
}

model Payable {
  id          String       @id @default(cuid())
  code        String       @unique
  supplierId  String?
  supplier    Supplier?    @relation(fields: [supplierId], references: [id])
  categoryId  Int?
  category    TxnCategory? @relation(fields: [categoryId], references: [id])
  description String
  amount      Int
  billDate    DateTime     @db.Date
  dueDate     DateTime     @db.Date
  createdAt   DateTime     @default(now())
}

model PayrollPeriod {
  id         String        @id @default(cuid())
  month      String        @unique // "2026-10"
  status     String // IMPORTED | LOCKED | PAID
  sourceFile String
  importedAt DateTime
  lines      PayrollLine[]
}

model PayrollLine {
  id               String        @id @default(cuid())
  periodId         String
  period           PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee      @relation(fields: [employeeId], references: [id])
  workDays         Decimal       @db.Decimal(5, 2)
  teachingSessions Int?
  baseSalary       Int
  allowance        Int           @default(0)
  bonus            Int           @default(0)
  deduction        Int           @default(0)
  insurance        Int           @default(0)
  pit              Int           @default(0)
  netPay           Int

  @@unique([periodId, employeeId])
}

model JournalEntry {
  id          String        @id @default(cuid())
  date        DateTime      @db.Date
  voucherType String // PT, PC, BC, BN, CT, HP (học phí), MH (mua hàng), LUONG, NVK
  voucherNo   String
  description String
  sourceType  String? // CashTxn | Invoice | Payable | PayrollPeriod | MANUAL
  sourceId    String?
  lines       JournalLine[]
  createdAt   DateTime      @default(now())

  @@unique([voucherType, voucherNo])
  @@index([date])
  @@index([sourceType, sourceId])
}

model JournalLine {
  id            String       @id @default(cuid())
  entryId       String
  entry         JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountCode   String
  debit         Int          @default(0)
  credit        Int          @default(0)
  studentId     String?
  supplierId    String?
  employeeId    String?
  cashAccountId String?
  classId       String?

  @@index([accountCode])
  @@index([studentId])
  @@index([supplierId])
}
