# Chép thành .env rồi điền giá trị thật. KHÔNG đưa .env lên GitHub.

# Cổng app (Docker ở máy tính: 3005; VPS chạy pm2: 3300) và cổng database (chỉ mở trong máy)
APP_PORT=3005
DB_PORT=5441

# Mật khẩu database (dùng cho docker-compose) – đặt mật khẩu mạnh
DB_PASSWORD=
# Kết nối database, mật khẩu và cổng phải khớp 2 dòng trên
# Máy tính: postgresql://worldmap:<DB_PASSWORD>@localhost:<DB_PORT>/worldmap?schema=public
DATABASE_URL=

# Khoá bí mật cho phiên đăng nhập: tạo bằng `openssl rand -base64 32`
AUTH_SECRET=
# Địa chỉ app, ví dụ http://localhost:3005 hoặc https://quanly.tenmien.vn
AUTH_URL=
AUTH_TRUST_HOST=true

# true = nạp dữ liệu mẫu khi chạy Docker lần đầu (chỉ để xem thử, không dùng khi chạy thật)
SEED_DEMO=false
